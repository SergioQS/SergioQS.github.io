<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-1" role="main">
      {% if page.toc and page.toc.sidebar %}
        <!-- table of contents behind an "Índice" button (left or right side); the list is filled in by assets/js/common.js -->
        <div class="toc-float toc-float-{% if page.toc.sidebar == 'right' %}right{% else %}left{% endif %}">
          <div class="toc-box">
            <button type="button" id="toc-toggle" class="toc-toggle" aria-expanded="false" aria-controls="toc-sidebar">
              <i class="fa-solid fa-list-ul" aria-hidden="true"></i>
              {% include t.liquid k="toc_title" %}
            </button>
            <nav id="toc-sidebar" class="toc-panel" aria-labelledby="toc-toggle"></nav>
          </div>
        </div>
      {% endif %}
      {{ content }}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
