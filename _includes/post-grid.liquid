<!-- Post feed: aalampour-style clean list -->
<div class="post-feed">
  {% for post in site.posts %}
    {% unless post.path contains '_Old_posts' %}
      <a href="{{ post.url | relative_url }}" class="post-feed-item">
        <div class="post-feed-meta">
          {% if post.categories %}
            <span class="post-feed-category">{{ post.categories | first }}</span>
          {% endif %}
          <span class="post-feed-date">{{ post.date | date: "%b %d, %Y" }}</span>
        </div>
        <h4 class="post-feed-title">{{ post.title }}</h4>
        {% if post.description %}
          <p class="post-feed-desc">{{ post.description | truncate: 120 }}</p>
        {% endif %}
      </a>
    {% endunless %}
  {% endfor %}
</div>
