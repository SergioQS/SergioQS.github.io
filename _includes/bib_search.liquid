{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <input
    type="text"
    id="bibsearch"
    spellcheck="false"
    autocomplete="off"
    class="search bibsearch-form-input"
    placeholder="{{ site.data.i18n.bib_filter.es }}"
    data-i18n-attr="placeholder"
    data-placeholder-es="{{ site.data.i18n.bib_filter.es }}"
    data-placeholder-en="{{ site.data.i18n.bib_filter.en }}"
  >
{% endif %}
